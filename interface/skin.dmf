		saved-params = "pos;size;is-minimized;is-maximized"
		statusbar = false
		icon = 'icons\\ss_32.png'
		macro = "default"
		menu = "menu"
		outer-size = 656x499
		outer-pos = 291,0
		inner-size = 640x440
		inner-pos = 8,51
		screen-size = 2560x1400
